-- Channel posts. Composite PK matches the t.me/<u>/<seq> URL shape so we never
-- need a synthetic auto-increment id and can map any deep link to a row in O(1).
--
-- Storage shape choices:
--   • text_html — original markup from the parser. Source of truth for rendering.
--   • text_plain — HTML-stripped plain text, stored LOWERCASED (Kotlin
--     String.lowercase(), Unicode-aware) because it is only a search column:
--     SQLite's LOWER() folds ASCII only, so searchPlain can't case-fold
--     Cyrillic / accented text at query time. Never displayed.
--   • media_json / web_preview_json / forwarded_from_json / reactions_json —
--     these are already-immutable Compose-stable structures (kotlinx.collections.immutable).
--     Storing as JSON avoids fan-out into auxiliary tables — we never query
--     "all posts containing video" cross-channel, and JOIN cost would dwarf the
--     savings. If that query pattern emerges later we add a media-kind column,
--     not a new table.
--   • published_at_ms — denormalized for fast range queries (`WHERE published_at_ms BETWEEN ? AND ?`)
--     and DESC-sorted index. The ISO string in published_at_iso is kept for the
--     UI which formats locale-aware "5 хв тому" deltas from the original source.
--
-- Media URL staleness:
--   t.me/s/ embeds CDN URLs with short-lived signed tokens (empirically 1-4 hours
--   for fresh posts). We don't store an explicit expiry — instead [fetched_at_ms]
--   doubles as a freshness probe: if a channel's LATEST post has
--   (now - fetched_at_ms) > MEDIA_TTL_MS, the next sweep prioritises that
--   channel for re-fetch. Coil's image loader catches 401/403/410 from a stale
--   URL; the UI then calls markMediaStale(:id), which zeroes fetched_at_ms so the
--   immediate channel re-fetch it triggers gets past the ingest fingerprint guard. Locally cached image bytes (Coil disk
--   cache) survive URL rotation because they're keyed by URL — only when a new
--   URL replaces the old one do we re-download bytes.

CREATE TABLE post (
    channel_username TEXT NOT NULL,
    seq INTEGER NOT NULL,
    -- "<channel>/<seq>" — globally unique post id, identical to t.me URL trailing path.
    id TEXT NOT NULL UNIQUE,

    published_at_iso TEXT NOT NULL,
    published_at_ms INTEGER NOT NULL,

    text_html TEXT NOT NULL DEFAULT '',
    text_plain TEXT NOT NULL DEFAULT '',

    media_json TEXT NOT NULL DEFAULT '[]',
    web_preview_json TEXT,
    forwarded_from_json TEXT,
    reactions_json TEXT NOT NULL DEFAULT '[]',
    views TEXT,

    -- User-state flags. Persisted across launches (no TDLib fallback for them).
    is_read INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    is_bookmarked INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,

    fetched_at_ms INTEGER NOT NULL,

    PRIMARY KEY (channel_username, seq),
    FOREIGN KEY (channel_username) REFERENCES channel(username) ON DELETE CASCADE
);

-- Primary feed sort. DESC-ordered so SQLite can serve the latest-first query
-- without an extra reverse pass.
CREATE INDEX post_published_idx ON post(published_at_ms DESC);

-- Per-channel feed (used by channel-filter view). Composite (channel, date DESC)
-- so the channel-filtered page also avoids a sort phase.
CREATE INDEX post_channel_published_idx ON post(channel_username, published_at_ms DESC);

-- Partial index — only rows the user actually bookmarked. Saves space vs a full
-- index when the bookmark set is the typical few-dozen vs the tens-of-thousands
-- of total posts.
CREATE INDEX post_bookmark_idx ON post(is_bookmarked) WHERE is_bookmarked = 1;

-- Search note: FTS5 virtual table was the original plan for cross-channel search,
-- but Samsung / OEM SQLite builds (the dominant Android population) ship without
-- the FTS5 module compiled in. CREATE VIRTUAL TABLE … USING fts5 fails with
-- "no such module: fts5" on those builds. Until we bundle SQLite (Phase 2.5+,
-- via androidx.sqlite-bundled or similar), [searchPlain] below does a LIKE scan
-- on [text_plain]. No index is created on this column: SQLite cannot use a
-- B-tree index for `LOWER(text_plain) LIKE '%pattern%'` (functional expression
-- on the indexed column AND a leading wildcard both defeat any index). An
-- earlier `post_text_plain_idx` was created in v1 with the (false) hope of
-- "index-driven scan rather than full-table", but EXPLAIN QUERY PLAN confirms
-- it never participated in the search path; meanwhile every INSERT / UPDATE
-- paid the index-maintenance cost. Dropped in migration 2.sqm (v2 → v3).

-- Queries. Each uses the appropriate index above so EXPLAIN QUERY PLAN should
-- never show SCAN TABLE for the hot paths.

selectFeed:
-- Global feed: latest from every subscribed channel. Joining on channel keeps
-- posts from unsubscribed channels out without needing a separate cleanup pass.
-- Tie-break by `seq` so same-second posts hold a deterministic order (Telegram
-- t.me/s/<u> pages compress to per-second timestamps; without the secondary
-- key, SQLite's row order is undefined and the feed can shuffle between sweeps).
SELECT post.*, channel.title AS channel_title, channel.avatar_url AS channel_avatar
FROM post
JOIN channel ON channel.username = post.channel_username
WHERE channel.is_subscribed = 1
ORDER BY post.published_at_ms DESC, post.seq DESC
LIMIT :limit;

selectFeedByChannel:
SELECT post.*, channel.title AS channel_title, channel.avatar_url AS channel_avatar
FROM post
JOIN channel ON channel.username = post.channel_username
WHERE post.channel_username = :username
ORDER BY post.published_at_ms DESC, post.seq DESC
LIMIT :limit;

-- LIKE-based fallback while FTS5 is unavailable (see header). The :pattern
-- parameter expects a glob-style pattern with leading/trailing %; caller
-- assembles it (escape any user-supplied %  / _ as needed). Sort by recency
-- because we don't have bm25 ranking — newest match wins, which matches user
-- expectation for a news feed anyway.
--
-- Case-insensitivity: SQLite's LIKE and LOWER() fold case for ASCII only —
-- Android's bundled SQLite has no ICU module, so LOWER('Привіт') stays
-- 'Привіт'. The fold therefore happens in Kotlin on BOTH sides: ingest stores
-- text_plain already lowercased (String.lowercase(), Unicode-aware) and the
-- caller lowercases the bare query before wrapping it with %…%. The SQL-side
-- LOWER() is kept only for rows written before ingest lowercased (ASCII still
-- matches); WebRepository.vacuum() rewrites those rows.
--
-- Index trade-off: post_text_plain_idx is unused by this query because
-- LOWER() on the indexed column defeats it. That's acceptable — the LIKE
-- pattern already has a leading wildcard which alone defeats prefix-index
-- lookups, so the index never helped this query in practice. The header
-- note "5K posts × 2KB sub-100ms on low-end devices" still holds; SQLite
-- runs a sequential scan with the LOWER() applied per row.
searchPlain:
SELECT post.*, channel.title AS channel_title, channel.avatar_url AS channel_avatar
FROM post
JOIN channel ON channel.username = post.channel_username
WHERE LOWER(post.text_plain) LIKE :pattern ESCAPE '\'
  AND channel.is_subscribed = 1
ORDER BY post.published_at_ms DESC, post.seq DESC
LIMIT :limit;

-- Two-step upsert (portable across SQLite < 3.24 on older Android — see
-- Channel.sq for the full rationale). Caller wraps both in one transaction.
-- The user-state columns (is_read, is_bookmarked) are deliberately excluded
-- from the UPDATE statement so re-fetching never undoes a "read" or "bookmark"
-- the user already set on this post.

upsertInsert:
INSERT OR IGNORE INTO post(
    channel_username, seq, id, published_at_iso, published_at_ms,
    text_html, text_plain, media_json, web_preview_json, forwarded_from_json,
    reactions_json, views, fetched_at_ms
) VALUES (
    :channelUsername, :seq, :id, :publishedAtIso, :publishedAtMs,
    :textHtml, :textPlain, :mediaJson, :webPreviewJson, :forwardedFromJson,
    :reactionsJson, :views, :fetchedAtMs
);

upsertUpdate:
UPDATE post SET
    published_at_iso = :publishedAtIso,
    published_at_ms = :publishedAtMs,
    text_html = :textHtml,
    text_plain = :textPlain,
    media_json = :mediaJson,
    web_preview_json = :webPreviewJson,
    forwarded_from_json = :forwardedFromJson,
    reactions_json = :reactionsJson,
    views = :views,
    fetched_at_ms = :fetchedAtMs
WHERE channel_username = :channelUsername AND seq = :seq;

-- Cheap fingerprint for the upsert path. ingestPost serialises 4 JSON blobs
-- (media / preview / forward / reactions) on EVERY incoming post — even the
-- ones that didn't change since the last sweep. On a 200-channel daily sweep
-- where most channels publish nothing, this is ~80 % wasted work. Fingerprint
-- compares text_html + views (the two fields that almost always change first
-- when a post is edited or reacted to) under the same composite key the
-- upsert uses; on a match we skip the four JSON serialises and the UPDATE.
-- Returns a single row when the post exists, empty otherwise. The guard is
-- bypassed on a media-refresh fetch (forceMediaRefresh — the media-TTL sweep and
-- the reactive stale-URL refetch, deliberately NOT a blanket pull-to-refresh) so a
-- plateaued post whose text/views are unchanged still picks up rotated CDN media
-- URLs, and on fetched_at_ms == 0 (markMediaStale escape hatch).
-- Search-text normalisation backfill (WebRepository.vacuum): rows ingested
-- before text_plain was stored lowercased. Kotlin decides which rows differ —
-- SQLite's LOWER() can't fold non-ASCII.
selectSearchText:
SELECT id, text_plain FROM post;

updateSearchText:
UPDATE post SET text_plain = :textPlain WHERE id = :id;

-- published_at_iso / published_at_ms ride along so a re-ingest whose date
-- selector failed (empty / unparseable ISO) keeps the stored valid timestamp
-- instead of overwriting it with the fetch-time fallback.
selectFingerprint:
SELECT text_html, views, fetched_at_ms, published_at_iso, published_at_ms FROM post
WHERE channel_username = :channelUsername AND seq = :seq;

-- Saved tab source: every bookmarked post, with no subscription filter and no
-- LIMIT — a saved post must outlive both the feed's newest-N window and an
-- unsubscribe. Served by the partial post_bookmark_idx. Same projection as
-- selectFeed so the shared row mapper applies.
selectBookmarked:
SELECT post.*, channel.title AS channel_title, channel.avatar_url AS channel_avatar
FROM post
JOIN channel ON channel.username = post.channel_username
WHERE post.is_bookmarked = 1
ORDER BY post.published_at_ms DESC, post.seq DESC;

-- Ids currently flagged, for the BookmarkStore → is_bookmarked mirror diff.
selectBookmarkedIds:
SELECT id FROM post WHERE is_bookmarked = 1;

-- Whether a channel already has stored posts. A fetched page with zero posts for
-- such a channel is treated as a parse failure, not an "ok" empty channel.
countByChannel:
SELECT COUNT(*) FROM post WHERE channel_username = :username;

markRead:
UPDATE post SET is_read = 1 WHERE id = :id;

setBookmark:
UPDATE post SET is_bookmarked = :bookmarked WHERE id = :id;

-- Called by the UI when Coil reports a 401/403/410 loading a media URL — that
-- post's CDN tokens have expired and need fresh signing. Zeroing fetched_at_ms
-- lets the caller's immediate channel re-fetch past the ingest fingerprint guard
-- (and, for a channel's latest post, also into the next
-- selectChannelsWithStaleMedia sweep).
markMediaStale:
UPDATE post SET fetched_at_ms = 0 WHERE id = :id;

-- Reverse lookup: the post id owning a given media / preview CDN URL. Used by the
-- Coil error path (WebFeedSource.refetchForStaleMediaUrl) to map an expired image
-- URL back to its post so the channel can be re-fetched. The URL is matched as a
-- LIKE substring of the JSON blobs (media_json holds photo/video/poster URLs;
-- web_preview_json holds link-preview image URLs). Caller escapes % / _ / \ in the
-- URL and wraps it in %…%; ESCAPE '\' so those escapes match literally. No index —
-- a full scan over the ≤1000-row feed table, only hit on a rare stale-URL error.
selectIdByMediaUrl:
SELECT id FROM post
WHERE media_json LIKE :pattern ESCAPE '\'
   OR (web_preview_json IS NOT NULL AND web_preview_json LIKE :pattern ESCAPE '\')
LIMIT 1;

-- Channel usernames whose LATEST post (highest seq) was fetched before the media
-- TTL. Used by WebFeedSource to drive proactive re-fetch of channels whose CDN URLs
-- are likely already invalid. One row per channel.
--
-- Must look at the latest post only: a fetch re-stamps fetched_at_ms on just the
-- one page of posts it returned, so older history keeps its original stamp
-- forever. Matching ANY old post flagged nearly every channel on every sweep and
-- turned each refresh into a forced, guard-bypassing full re-ingest. The
-- (channel_username, seq) primary key serves the MAX(seq) subquery.
selectChannelsWithStaleMedia:
SELECT post.channel_username
FROM post
JOIN channel ON channel.username = post.channel_username
WHERE channel.is_subscribed = 1
  AND post.seq = (
      SELECT MAX(p2.seq) FROM post AS p2
      WHERE p2.channel_username = post.channel_username
  )
  AND post.fetched_at_ms < :olderThanMs;

-- Vacuum old posts. Retains the latest :keepCount per channel; called from
-- WebRepository.vacuum() periodically (Phase 1.5 wires it in WorkManager).
-- Bookmarks always survive — we never drop something the user explicitly saved.
deleteOldPerChannel:
DELETE FROM post
WHERE is_bookmarked = 0
  AND id NOT IN (
      SELECT id FROM post AS p2
      WHERE p2.channel_username = post.channel_username
        AND p2.is_bookmarked = 0
      ORDER BY p2.published_at_ms DESC, p2.seq DESC
      LIMIT :keepCount
  );

deleteByChannel:
DELETE FROM post WHERE channel_username = :username AND is_bookmarked = 0;

deleteAll:
DELETE FROM post;

-- Soft variant used by "Clear cache" when the user opts to keep saved posts. The
-- partial post_bookmark_idx makes this a cheap index lookup rather than a full
-- table scan. Channel rows are NOT touched here either: subscriptions and read
-- cursors survive the wipe.
deleteAllExceptBookmarked:
DELETE FROM post WHERE is_bookmarked = 0;

-- Lightweight projection used by the AddChannelSheet "channels mentioned in
-- what you read" suggestion path. Returns just the two columns we scan client-
-- side for @username + forwarded_from extraction; avoids the heavy
-- TimelinePost JSON-decoding rowToTimelinePost pipeline used by selectFeed.
selectMentionsSource:
SELECT post.text_html, post.forwarded_from_json
FROM post
JOIN channel ON channel.username = post.channel_username
WHERE channel.is_subscribed = 1
ORDER BY post.published_at_ms DESC, post.seq DESC
LIMIT :limit;

-- Raw content snapshot for the diff-on-refresh archive path. Returns just the
-- fields [WebPostDiff] needs (id, seq, publishedAt, textHtml, media, preview,
-- forward) keyed by the channel PK. Not used by the read-side feed pipeline —
-- no JOIN on channel or TimelinePost mapping needed here.
selectRawByChannel:
SELECT id, seq, published_at_iso, text_html, media_json,
       web_preview_json, forwarded_from_json
FROM post
WHERE channel_username = :channelUsername;
