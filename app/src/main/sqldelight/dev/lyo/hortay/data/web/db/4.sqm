-- Schema migration: version 4 → 5.
--
-- Adds the per-channel unfinished back-fill record for guest mode (see
-- [ChannelGap.sq]) and the per-post extras column. Additive only — no existing column or index
-- touched.

CREATE TABLE channel_gap (
    username TEXT NOT NULL PRIMARY KEY,
    before_seq INTEGER NOT NULL,
    until_seq INTEGER NOT NULL,
    FOREIGN KEY(username) REFERENCES channel(username) ON DELETE CASCADE
);

-- Per-post extras (author signature, "edited" mark, reply header) as one JSON
-- object — see the column comment in Post.sq. Appended last, nullable.
ALTER TABLE post ADD COLUMN extras_json TEXT;

PRAGMA user_version = 5;
