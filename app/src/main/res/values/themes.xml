<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hortay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/system_neutral1_50</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Hortay</item>
    </style>

    <style name="Theme.Hortay" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
