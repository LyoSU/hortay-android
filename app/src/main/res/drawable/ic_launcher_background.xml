<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: 135-degree gradient, brand_gradient_top (top-left) to
     brand_gradient_bot (bottom-right). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="@color/brand_gradient_top" />
                <item android:offset="1.0" android:color="@color/brand_gradient_bot" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
