-- Permanent storage for media files copied out of TDLib's cache on capture. SHA-256 of
-- file contents is the primary key — two versions that show identical bytes share one
-- row (and one underlying file).
--
-- Lifecycle (no reference counting; v1 kept a manual ref_count, released from six call
-- sites that each had to decode blobs, and leaked whenever one was missed):
--   * Capture: ArchivedMediaStore.copyIfAvailable inserts the row, or re-stamps
--     claimed_at_ms on an existing one, BEFORE the version that references it is written.
--   * Reference: MessageVersion.media_sha. Nothing else counts.
--   * Removal: ArchivedMediaStore.sweepOrphans deletes a file no MessageVersion references
--     once its claimed_at_ms is older than a safety window, so a copy whose version row is
--     about to be written is never taken.
--
-- Why not use TDLib's local.path directly? Because TDLib's file cache is LRU
-- (message_unload_delay default 60s) and may evict the file at any moment
-- after capture. A snapshot that pointed at the TDLib path would lose its
-- media silently. Copying into our own filesDir guarantees survival.

CREATE TABLE ArchivedMediaFile (
    sha             TEXT PRIMARY KEY,
    path            TEXT NOT NULL,
    size_bytes      INTEGER NOT NULL,
    mime_type       TEXT,
    created_at_ms   INTEGER NOT NULL,
    -- Device clock of the latest capture that copied or reused this file.
    claimed_at_ms   INTEGER NOT NULL
);

selectBySha:
SELECT * FROM ArchivedMediaFile WHERE sha = ?;

insert:
INSERT OR IGNORE INTO ArchivedMediaFile(sha, path, size_bytes, mime_type, created_at_ms, claimed_at_ms)
VALUES (?, ?, ?, ?, ?, ?);

claim:
UPDATE ArchivedMediaFile SET claimed_at_ms = ? WHERE sha = ?;

deleteBySha:
DELETE FROM ArchivedMediaFile WHERE sha = ?;

selectOrphans:
SELECT f.sha, f.path
FROM ArchivedMediaFile f
WHERE f.claimed_at_ms < :claimedBefore
  AND NOT EXISTS (SELECT 1 FROM MessageVersion v WHERE v.media_sha = f.sha);

storageBytes:
SELECT COALESCE(SUM(size_bytes), 0) AS bytes FROM ArchivedMediaFile;

clearAll:
DELETE FROM ArchivedMediaFile;
