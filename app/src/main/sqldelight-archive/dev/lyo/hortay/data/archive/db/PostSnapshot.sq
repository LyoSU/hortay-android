CREATE TABLE PostSnapshot (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    source_kind     TEXT NOT NULL,
    source_key      TEXT NOT NULL,
    message_key     TEXT NOT NULL,
    album_key       TEXT,
    kind            TEXT NOT NULL,
    seen_at_ms      INTEGER NOT NULL,
    edited_at_ms    INTEGER,
    content_kind    TEXT NOT NULL,
    content_blob    BLOB NOT NULL,
    content_hash    TEXT NOT NULL,
    text_preview    TEXT NOT NULL DEFAULT '',
    media_minithumb BLOB,
    deleted_msg_keys TEXT,
    is_comment      INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_PostSnapshot_msg
    ON PostSnapshot(source_kind, source_key, message_key, seen_at_ms DESC);

CREATE INDEX idx_PostSnapshot_seen
    ON PostSnapshot(seen_at_ms DESC);

CREATE INDEX idx_PostSnapshot_id
    ON PostSnapshot(id);

insert:
INSERT INTO PostSnapshot(source_kind, source_key, message_key, album_key, kind, seen_at_ms, edited_at_ms,
                        content_kind, content_blob, content_hash, text_preview, media_minithumb,
                        deleted_msg_keys, is_comment)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

latestForMessage:
SELECT seen_at_ms, content_hash
FROM PostSnapshot
WHERE source_kind = ? AND source_key = ? AND message_key = ?
ORDER BY seen_at_ms DESC, id DESC
LIMIT 1;

selectRevisions:
SELECT *
FROM PostSnapshot
WHERE source_kind = ? AND source_key = ? AND message_key = ?
ORDER BY seen_at_ms ASC, id ASC;

countByMessage:
SELECT COUNT(*) AS cnt
FROM PostSnapshot
WHERE source_kind = ? AND source_key = ? AND message_key = ? AND kind = 'VERSION';

selectAllForFilter:
SELECT *
FROM PostSnapshot
WHERE (:sourceKind IS NULL OR source_kind = :sourceKind)
  AND (:kind IS NULL OR kind = :kind)
  AND (:isComment IS NULL OR is_comment = :isComment)
  AND (:query IS NULL OR text_preview LIKE :query)
ORDER BY seen_at_ms DESC;

deleteByIds:
DELETE FROM PostSnapshot WHERE id IN ?;

-- Same blob-collection pattern as selectBlobsOlderThan / selectBlobsByCap —
-- needed so user-initiated purges (swipe-to-dismiss in ArchiveScreen) also
-- release their media refcount instead of orphaning files.
selectBlobsByIds:
SELECT content_blob FROM PostSnapshot WHERE id IN ?;

deleteOlderThan:
DELETE FROM PostSnapshot WHERE seen_at_ms < ?;

deleteByCap:
DELETE FROM PostSnapshot
WHERE id <= (SELECT MAX(id) FROM PostSnapshot) - ?;

-- Returns content_blob bytes for every row that would be deleted by
-- deleteOlderThan. The sweep decodes each blob to recover the media SHA,
-- releases the refcount in ArchivedMediaFile, then runs deleteOlderThan
-- itself. Two-step is needed because deleteOlderThan doesn't have a
-- RETURNING clause portable across the older SQLite versions on min-SDK
-- 26 devices (see Web-mode SQL portability note in ARCHITECTURE.md).
selectBlobsOlderThan:
SELECT content_blob FROM PostSnapshot WHERE seen_at_ms < ?;

-- Same idea for the cap-based eviction.
selectBlobsByCap:
SELECT content_blob FROM PostSnapshot
WHERE id <= (SELECT MAX(id) FROM PostSnapshot) - ?;

clearAll:
DELETE FROM PostSnapshot;

storageBytes:
SELECT COALESCE(SUM(LENGTH(content_blob) + LENGTH(COALESCE(media_minithumb, ''))), 0) AS bytes
FROM PostSnapshot;

selectAllForExport:
SELECT *
FROM PostSnapshot
ORDER BY seen_at_ms ASC;

selectLatestVersionForMessage:
SELECT *
FROM PostSnapshot
WHERE source_kind = ? AND source_key = ? AND message_key = ? AND kind = 'VERSION'
ORDER BY id DESC
LIMIT 1;

-- "Baseline" = the as-published VERSION row, stamped with edited_at_ms IS NULL
-- so it remains identifiable across edits. At most one per message. Used by
-- captureTdlibBaseline as the existence check so a race between cold-start
-- ingest and an early UpdateMessageEdited can't either skip the baseline
-- OR write it with the edit-row's clock() timestamp — see
-- ArchiveRepository.captureTdlibBaseline KDoc.
selectBaselineForMessage:
SELECT id
FROM PostSnapshot
WHERE source_kind = ? AND source_key = ? AND message_key = ?
  AND kind = 'VERSION' AND edited_at_ms IS NULL
LIMIT 1;

-- Latest known album_key for a message — used by captureTdlibDeleteSmart to
-- coalesce album members into a single DELETED row even when the deletion
-- arrives for posts that were never resident in `_posts` (cold-start catch-up
-- after TDLib's getChannelDifference). Returns NULL for a standalone post.
selectAlbumKeyForMessage:
SELECT album_key
FROM PostSnapshot
WHERE source_kind = ? AND source_key = ? AND message_key = ?
  AND kind = 'VERSION'
ORDER BY id DESC
LIMIT 1;

-- Counts admin edits per message. Baseline VERSIONs (captured on first ingest)
-- always pair with at least one row, so the natural edit-count formula is
-- `total VERSIONs - 1` (the -1 swallows the baseline). HAVING > 1 then hides
-- never-edited posts whose only row is the baseline itself — without this
-- guard every archived post would surface an EditedChip.
--
-- The `-1` form is intentionally robust to legacy data: pre-Phase-4 captures
-- wrote VERSIONs with `edited_at_ms IS NULL` for real edits too, so a column
-- filter would have lost the count for them. Subtraction works uniformly.
selectTdlibVersionCounts:
SELECT source_key, message_key, COUNT(*) - 1 AS cnt
FROM PostSnapshot
WHERE source_kind = 'TDLIB' AND kind = 'VERSION'
GROUP BY source_key, message_key
HAVING cnt > 0;

-- Joined tombstone read: one row per DELETED snapshot, with latest VERSION
-- content_blob and ArchivedChannel metadata. Replaces the previous N+M
-- per-row lookup loop in ArchiveRepository.buildTombstone — that path used to
-- issue O(deletedRows × 2) extra SELECTs on every flow re-emit, which
-- becomes painful as the archive grows past a few hundred rows.
selectTombstonesJoined:
SELECT d.source_kind        AS d_source_kind,
       d.source_key         AS d_source_key,
       d.message_key        AS d_message_key,
       d.seen_at_ms         AS d_seen_at_ms,
       d.deleted_msg_keys   AS d_deleted_msg_keys,
       v.content_blob       AS v_content_blob,
       v.seen_at_ms         AS v_seen_at_ms,
       c.title              AS c_title,
       c.handle             AS c_handle,
       c.photo_minithumb    AS c_photo_minithumb,
       c.is_verified        AS c_is_verified
FROM PostSnapshot d
LEFT JOIN PostSnapshot v
    ON v.source_kind = d.source_kind
    AND v.source_key = d.source_key
    AND v.message_key = d.message_key
    AND v.kind = 'VERSION'
    AND v.id = (SELECT MAX(id) FROM PostSnapshot
                WHERE source_kind = d.source_kind
                  AND source_key = d.source_key
                  AND message_key = d.message_key
                  AND kind = 'VERSION')
LEFT JOIN ArchivedChannel c
    ON c.source_kind = d.source_kind AND c.source_key = d.source_key
-- is_comment = 0 keeps deleted *comments* out of the channel feed: a deleted
-- comment lives only inside its discussion thread, so reconstructing it as a
-- ghost card in the channel timeline would surface a tombstone where the
-- original post never existed for the reader. Comment tombstones still live
-- in the archive (selectAllForFilter with scope = COMMENTS reaches them); the
-- filter is purely scoped to the feed-reconstruction read path.
WHERE d.kind = 'DELETED' AND d.source_kind = 'TDLIB' AND d.is_comment = 0
ORDER BY d.seen_at_ms DESC;
