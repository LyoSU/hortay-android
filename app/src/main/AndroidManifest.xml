<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- CSAE-compliance: GuestReportDelegator probes for installed Telegram clients
         via PackageManager.getPackageInfo() (requires a <queries> declaration on
         API 30+) and launches Custom Tabs for the web fallback. The mailto: intent
         is the last-resort fallback to abuse@telegram.org. -->
    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.telegram.plus" />
        <package android:name="nekox.messenger" />
        <package android:name="org.thunderdog.challegram" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".HortayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hortay.Splash"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hortay.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- tg:// deep links (resolve / privatepost / openmessage). We intentionally
                 register without autoVerify so we appear alongside the official Telegram
                 client in the chooser; the user can pick Hortay once and Android remembers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tg" />
            </intent-filter>

            <!-- https://t.me/... share links. Same chooser behaviour — Android shows both
                 Hortay and Telegram. autoVerify=true is set per Android 12+ App-Link
                 hygiene (tells Android to attempt domain verification rather than treat
                 the filter as ambiguous). Verification WILL FAIL server-side because
                 we don't control t.me's /.well-known/assetlinks.json, so we never become
                 the default handler — chooser behaviour is preserved. The flag silences
                 the AppLinkWarning lint and keeps the manifest semantically honest about
                 what we're declaring.

                 The <data> tags are split into single-attribute elements per the
                 IntentFilterUniqueDataAttributes guidance: the runtime intent matcher
                 takes the cross-product of every scheme × host inside one filter, so
                 the split form is semantically equivalent here AND makes that
                 combining behaviour explicit to anyone reading the manifest. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="t.me" />
            </intent-filter>
        </activity>

        <!-- FileProvider for "Copy" / future "Share" actions in the fullscreen media viewer.
             TDLib stores downloaded media under filesDir/tdlib-files/...; that path is
             private to the app so we mint a content:// URI through FileProvider whenever
             the user copies an image to the clipboard, then grant FLAG_GRANT_READ_URI_PERMISSION
             so the target app (gallery, messenger, etc.) can read it. Authority is
             "${applicationId}.fileprovider" so the .beta build variant gets its own. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
